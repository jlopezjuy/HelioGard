    <!--
        Added the constraints for entity AuditAnswer.
    -->
    <changeSet id="20261124023956-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="audit_answer"
                                 constraintName="fk_audit_answer__organization_id"
