<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity AuditReport.
    -->
    <changeSet id="20261124023955-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="audit_report"
                                 constraintName="fk_audit_report__organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"
                                 />

        <addForeignKeyConstraint baseColumnNames="installation_id"
                                 baseTableName="audit_report"
                                 constraintName="fk_audit_report__installation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="installation"
                                 />

        <addForeignKeyConstraint baseColumnNames="audit_template_id"
                                 baseTableName="audit_report"
                                 constraintName="fk_audit_report__audit_template_id"
                                 referencedColumnNames="id"
                                 referencedTableName="audit_template"
                                 />

        <addForeignKeyConstraint baseColumnNames="auditor_membership_id"
                                 baseTableName="audit_report"
                                 constraintName="fk_audit_report__auditor_membership_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization_membership"
                                 />
    </changeSet>
</databaseChangeLog>
