    <!--
        Added the constraints for entity SecurityIncident.
    -->
    <changeSet id="20261124024019-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="security_incident"
                                 constraintName="fk_security_incident__organization_id"
