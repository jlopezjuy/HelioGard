<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ServiceProposal.
    -->
    <changeSet id="20261124024004-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="service_proposal"
                                 constraintName="fk_service_proposal__organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"
                                 />

        <addForeignKeyConstraint baseColumnNames="installation_id"
                                 baseTableName="service_proposal"
                                 constraintName="fk_service_proposal__installation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="installation"
                                 />

        <addForeignKeyConstraint baseColumnNames="plan_version_id"
                                 baseTableName="service_proposal"
                                 constraintName="fk_service_proposal__plan_version_id"
                                 referencedColumnNames="id"
                                 referencedTableName="maintenance_plan_version"
                                 />
    </changeSet>
</databaseChangeLog>
