<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Installation.
    -->
    <changeSet id="20261124023925-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="installation"
                                 constraintName="fk_installation__organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"
                                 />

        <addForeignKeyConstraint baseColumnNames="site_id"
                                 baseTableName="installation"
                                 constraintName="fk_installation__site_id"
                                 referencedColumnNames="id"
                                 referencedTableName="site"
                                 />

        <addForeignKeyConstraint baseColumnNames="climate_risk_profile_id"
                                 baseTableName="installation"
                                 constraintName="fk_installation__climate_risk_profile_id"
                                 referencedColumnNames="id"
                                 referencedTableName="climate_risk_profile"
                                 />
    </changeSet>
</databaseChangeLog>
