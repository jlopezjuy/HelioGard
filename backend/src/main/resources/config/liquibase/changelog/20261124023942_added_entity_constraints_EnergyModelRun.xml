    <!--
        Added the constraints for entity EnergyModelRun.
    -->
    <changeSet id="20261124023942-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="energy_model_run"
                                 constraintName="fk_energy_model_run__organization_id"
                                 referencedColumnNames="id"
