<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity EquipmentConnection.
    -->
    <changeSet id="20261124023937-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="equipment_connection"
                                 constraintName="fk_equipment_connection__organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"
                                 />

        <addForeignKeyConstraint baseColumnNames="from_equipment_id"
                                 baseTableName="equipment_connection"
                                 constraintName="fk_equipment_connection__from_equipment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="equipment"
                                 />

        <addForeignKeyConstraint baseColumnNames="to_equipment_id"
                                 baseTableName="equipment_connection"
                                 constraintName="fk_equipment_connection__to_equipment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="equipment"
                                 />
    </changeSet>
</databaseChangeLog>
