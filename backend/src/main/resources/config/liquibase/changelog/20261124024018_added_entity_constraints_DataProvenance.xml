<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity DataProvenance.
    -->
    <changeSet id="20261124024018-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="data_provenance"
                                 constraintName="fk_data_provenance__organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"
                                 />

        <addForeignKeyConstraint baseColumnNames="installation_id"
                                 baseTableName="data_provenance"
                                 constraintName="fk_data_provenance__installation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="installation"
                                 />

        <addForeignKeyConstraint baseColumnNames="evidence_source_id"
                                 baseTableName="data_provenance"
                                 constraintName="fk_data_provenance__evidence_source_id"
                                 referencedColumnNames="id"
                                 referencedTableName="evidence_source"
                                 />

        <addForeignKeyConstraint baseColumnNames="model_run_id"
                                 baseTableName="data_provenance"
                                 constraintName="fk_data_provenance__model_run_id"
                                 referencedColumnNames="id"
                                 referencedTableName="energy_model_run"
                                 />
    </changeSet>
</databaseChangeLog>
