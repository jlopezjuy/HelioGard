<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity VerificationResult.
    -->
    <changeSet id="20261124024023-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="verification_result"
                                 constraintName="fk_verification_result__organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"
                                 />

        <addForeignKeyConstraint baseColumnNames="installation_id"
                                 baseTableName="verification_result"
                                 constraintName="fk_verification_result__installation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="installation"
                                 />

        <addForeignKeyConstraint baseColumnNames="drone_mission_id"
                                 baseTableName="verification_result"
                                 constraintName="fk_verification_result__drone_mission_id"
                                 referencedColumnNames="id"
                                 referencedTableName="drone_mission"
                                 />

        <addForeignKeyConstraint baseColumnNames="recovery_assessment_id"
                                 baseTableName="verification_result"
                                 constraintName="fk_verification_result__recovery_assessment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="recovery_assessment"
                                 />
    </changeSet>
</databaseChangeLog>
