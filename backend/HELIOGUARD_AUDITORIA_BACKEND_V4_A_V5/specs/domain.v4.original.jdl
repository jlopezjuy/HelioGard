// HelioGuard — dominio transaccional multi-tenant v4 (BORRADOR, VALIDACIÓN PENDIENTE)
// No importar sin validar con la versión exacta de JHipster y contrastar esquema anterior.
// IMPORTANTE: JDL genera entidades base, NO RLS, índices compuestos, validación cruzada ni control de acceso.
// Datos crudos de telemetría se modelan en SQL independiente (no con CRUD JDL).
// Seguridad: claves privadas, tokens y payloads sensibles nunca se almacenan en las entidades.
// Fuente de verdad del dominio para HELIOGUARD: este archivo, no los JDL históricos.

enum OrganizationStatus { ACTIVE, SUSPENDED }
enum OrganizationKind { HOUSEHOLD, BUSINESS, SERVICE_PROVIDER }
enum MembershipRole { OWNER, ADMIN, OPERATOR, TECHNICIAN, AUDITOR, VIEWER }
enum MembershipStatus { INVITED, ACTIVE, SUSPENDED, REVOKED }
enum GridMode { GRID_TIED, HYBRID, OFF_GRID }
enum InstallationStatus { COMMISSIONING, ACTIVE, MAINTENANCE, INACTIVE }
enum EquipmentKind { MODULE, INVERTER, BATTERY, METER, SENSOR, OPTIMIZER, PROTECTION, OTHER }
enum EquipmentStatus { ACTIVE, FAILED, DECOMMISSIONED }
enum GatewayStatus { PROVISIONING, ONLINE, OFFLINE, REVOKED }
enum PermissionScope { READ_ONLY, AUDIT, MAINTENANCE, MANAGE }
enum AlertSeverity { INFO, LOW, MEDIUM, HIGH, CRITICAL }
enum IncidentStatus { OPEN, ACKNOWLEDGED, IN_PROGRESS, RESOLVED, CLOSED }
enum LossCause { SOILING, HARDWARE, SHADING, THERMAL, WEATHER, CURTAILMENT, BATTERY_RESTRICTION, UNKNOWN }
enum AuditStatus { DRAFT, IN_PROGRESS, SUBMITTED, APPROVED, REJECTED }
enum FindingSeverity { LOW, MEDIUM, HIGH, CRITICAL }
enum WorkOrderStatus { CREATED, ASSIGNED, ACCEPTED, IN_PROGRESS, DONE, VERIFIED, CANCELLED }
enum WorkTaskStatus { TODO, IN_PROGRESS, DONE, BLOCKED }
enum InterventionType { INSPECTION, CLEANING, REPAIR, REPLACEMENT }
enum MaintenancePlanStatus { DRAFT, ACTIVE, RETIRED }
enum SubscriptionStatus { PROPOSED, ACTIVE, SUSPENDED, CANCELLED, EXPIRED }
enum ServiceAgreementStatus { REQUESTED, ACTIVE, SUSPENDED, CLOSED }

enum DeviceTrustStatus { PROVISIONING, ACTIVE, SUSPENDED, REVOKED }
enum IntegrityEventType { REPLAY, DUPLICATE_EVENT, SEQUENCE_GAP, SIGNATURE_INVALID, AUTH_FAILURE, CLOCK_SKEW, PHYSICAL_INCONSISTENCY, DEVICE_UNAVAILABLE }
enum IntegrityEventStatus { OBSERVED, QUARANTINED, UNDER_REVIEW, EXPLAINED, CONFIRMED, CLOSED }
enum DataTrustLevel { VALIDATED, ESTIMATED, SUSPECT, UNKNOWN }
enum EvidenceSourceKind { SATELLITE_WEATHER, ONSITE_SENSOR, INVERTER, EDGE_GATEWAY, DRONE, MANUAL, MODEL }
enum SecurityCaseStatus { OPEN, TRIAGE, INVESTIGATING, MITIGATED, CLOSED }
enum DroneAssetStatus { READY, MAINTENANCE, GROUNDED, RETIRED }
enum DroneMissionKind { VISUAL_INSPECTION, THERMAL_INSPECTION, CLEANING }
enum DroneMissionStatus { DRAFT, SAFETY_REVIEW, AWAITING_AUTHORIZATION, AUTHORIZED, DISPATCHED, IN_FLIGHT, COMPLETED, ABORTED }
enum MissionAuthorizationStatus { PENDING, APPROVED, REJECTED, EXPIRED, REVOKED }
enum VerificationStatus { PENDING, INCONCLUSIVE, RECOVERED, NOT_RECOVERED }

// --- IDENTIDAD Y TENANCY ---
entity Organization {
  name String required maxlength(160)
  slug String required unique maxlength(80)
  status OrganizationStatus required
  kind OrganizationKind required
  createdAt Instant required
}
entity OrganizationMembership {
  role MembershipRole required
  status MembershipStatus required
  invitedAt Instant
  activatedAt Instant
}
entity Site {
  name String required maxlength(160)
  address String maxlength(250)
  latitude BigDecimal
  longitude BigDecimal
  altitudeM BigDecimal
  timeZone String required maxlength(64)
}
entity Installation {
  code String required maxlength(60)
  name String required maxlength(160)
  gridMode GridMode required
  status InstallationStatus required
  nominalDcKw BigDecimal required
  commissionedOn LocalDate
}
entity InstallationAccessGrant {
  scope PermissionScope required
  validFrom Instant required
  validUntil Instant
  revokedAt Instant
  reason String maxlength(250)
}

// --- INVENTARIO Y CONECTIVIDAD ---
// Catalogo global: NO tiene organization, restringir escritura a administradores plataforma.
entity EquipmentModel {
  manufacturer String required maxlength(120)
  modelCode String required maxlength(120)
  revision String maxlength(60)
  kind EquipmentKind required
  nominalPowerW BigDecimal
}
entity SolarArray {
  name String required maxlength(120)
  azimuthDegrees BigDecimal
  tiltDegrees BigDecimal
  commissionedOn LocalDate
}
entity SolarString {
  stringCode String required maxlength(80)
  modulesInSeries Integer required min(1)
  active Boolean required
}
entity Equipment {
  tag String required maxlength(120)
  serialNumber String maxlength(160)
  kind EquipmentKind required
  status EquipmentStatus required
  installedOn LocalDate
  removedOn LocalDate
}
entity Gateway {
  hardwareId String required unique maxlength(120)
  firmwareVersion String maxlength(80)
  status GatewayStatus required
  lastSeenAt Instant
  provisionedAt Instant
}
// Catalogo global de magnitudes, unidades canonicas y semantica de medicion.
entity MetricDefinition {
  code String required unique maxlength(100)
  unitCode String required maxlength(24)
  description String maxlength(250)
  counter Boolean required
}
entity TelemetryChannel {
  externalChannelCode String required maxlength(100)
  enabled Boolean required
  samplePeriodSeconds Integer min(1)
}

// --- REGLAS, INCIDENTES Y MODELOS ENERGÉTICOS ---
entity AlertRule {
  name String required maxlength(120)
  ruleCode String required maxlength(100)
  severity AlertSeverity required
  enabled Boolean required
  thresholdValue BigDecimal
  minPersistenceSeconds Integer
}
entity Incident {
  title String required maxlength(180)
  severity AlertSeverity required
  status IncidentStatus required
  firstSeenAt Instant required
  lastSeenAt Instant required
  acknowledgedAt Instant
  resolvedAt Instant
  dedupKey String required maxlength(180)
}
entity IncidentEvent {
  occurredAt Instant required
  eventCode String required maxlength(80)
  detail TextBlob
}
entity EnergyModelRun {
  modelName String required maxlength(100)
  modelVersion String required maxlength(50)
  periodStart Instant required
  periodEnd Instant required
  expectedWh BigDecimal required
  actualWh BigDecimal
  coveragePct BigDecimal
  inputFingerprint String maxlength(100)
  calculatedAt Instant required
}
entity LossAssessment {
  totalLossWh BigDecimal required
  lossPct BigDecimal
  methodology String required maxlength(100)
  assessedAt Instant required
  validationStatus String required maxlength(60)
}
entity LossCauseEstimate {
  cause LossCause required
  estimatedWh BigDecimal required
  method String required maxlength(100)
  evidenceNote TextBlob
}

// --- TARIFAS Y VALORIZACIÓN ---
entity TariffPlan {
  name String required maxlength(140)
  currencyCode String required maxlength(3)
  distributor String maxlength(160)
}
entity TariffRate {
  validFrom Instant required
  validTo Instant
  purchasePricePerKwh BigDecimal required
  exportPricePerKwh BigDecimal
}
entity EconomicAssessment {
  assessedAt Instant required
  currencyCode String required maxlength(3)
  selfConsumptionLostWh BigDecimal
  exportedLostWh BigDecimal
  estimatedLossAmount BigDecimal required
  tariffSnapshotNote String maxlength(300)
}

// --- AUDITORÍA TÉCNICA ---
entity AuditTemplate {
  title String required maxlength(160)
  templateVersion String required maxlength(50)
  active Boolean required
  publishedAt Instant
}
entity AuditQuestion {
  questionCode String required maxlength(80)
  label String required maxlength(300)
  answerType String required maxlength(40)
  sortOrder Integer required
  mandatory Boolean required
}
entity AuditReport {
  status AuditStatus required
  startedAt Instant required
  completedAt Instant
  summary TextBlob
}
entity AuditAnswer {
  answerText TextBlob
  answeredAt Instant
  compliant Boolean
}
entity AuditFinding {
  title String required maxlength(160)
  severity FindingSeverity required
  description TextBlob required
  recommendation TextBlob
  resolvedAt Instant
}
entity AuditEvidence {
  storageKey String required maxlength(400)
  mimeType String required maxlength(100)
  sha256 String maxlength(64)
  capturedAt Instant
}

// --- MANTENIMIENTO Y PLANES COMERCIALES ---
entity MaintenancePlan {
  name String required maxlength(150)
  status MaintenancePlanStatus required
}
entity MaintenancePlanVersion {
  versionCode String required maxlength(50)
  publishedAt Instant
  currencyCode String required maxlength(3)
  recurringAmount BigDecimal required
  termsReference String required maxlength(400)
}
entity ServiceAgreement {
  status ServiceAgreementStatus required
  startsAt Instant required
  endsAt Instant
  approvedAt Instant
}
entity PlanSubscription {
  status SubscriptionStatus required
  activatedAt Instant
  expiresAt Instant
  agreedAmount BigDecimal
  currencyCode String maxlength(3)
}
entity ServiceProposal {
  referenceCode String required maxlength(70)
  proposedAt Instant required
  validUntil Instant
  amount BigDecimal required
  currencyCode String required maxlength(3)
  acceptedAt Instant
}
entity WorkOrder {
  referenceCode String required maxlength(80)
  title String required maxlength(160)
  status WorkOrderStatus required
  priority AlertSeverity required
  openedAt Instant required
  scheduledAt Instant
  closedAt Instant
}
entity WorkOrderTask {
  description String required maxlength(300)
  status WorkTaskStatus required
  sortOrder Integer required
}
entity MaintenanceIntervention {
  type InterventionType required
  startedAt Instant
  finishedAt Instant
  workCost BigDecimal
  currencyCode String maxlength(3)
  notes TextBlob
}
entity InterventionEvidence {
  storageKey String required maxlength(400)
  mimeType String required maxlength(100)
  sha256 String maxlength(64)
  capturedAt Instant
}
entity RecoveryAssessment {
  assessedAt Instant required
  baselineMethod String required maxlength(120)
  expectedRecoveredWh BigDecimal
  verifiedRecoveredWh BigDecimal
  confidenceNote TextBlob
}

// --- SEGURIDAD DE TELEMETRÍA, PROCEDENCIA Y MISIONES ---
// DeviceIdentity solo referencia huellas/ID de clave. El material criptográfico va en secret manager.
entity DeviceIdentity {
  deviceUid String required unique maxlength(140)
  keyFingerprint String maxlength(128)
  protocolName String required maxlength(80)
  trustStatus DeviceTrustStatus required
  keyRotatedAt Instant
  validUntil Instant
}
entity TelemetryIntegrityEvent {
  eventUid String required unique maxlength(140)
  eventType IntegrityEventType required
  status IntegrityEventStatus required
  observedAt Instant required
  sourceObservedAt Instant
  sequenceNumber Long
  payloadSha256 String maxlength(64)
  detail TextBlob
}
entity IntegrityAssessment {
  assessedAt Instant required
  trustLevel DataTrustLevel required
  ruleVersion String required maxlength(80)
  reason TextBlob
}
// Catálogo global de fuentes: no debe exponer secretos de APIs o credenciales.
entity EvidenceSource {
  code String required unique maxlength(100)
  providerName String required maxlength(160)
  kind EvidenceSourceKind required
  spatialResolutionM BigDecimal
  licenseReference String maxlength(300)
}
entity DataProvenance {
  sourceRecordKey String required maxlength(180)
  observedAt Instant required
  ingestedAt Instant required
  contentSha256 String maxlength(64)
  trustLevel DataTrustLevel required
  qualityFlags String maxlength(300)
  algorithmVersion String maxlength(80)
}
entity SecurityIncident {
  referenceCode String required maxlength(100)
  title String required maxlength(180)
  status SecurityCaseStatus required
  openedAt Instant required
  closedAt Instant
  resolutionNote TextBlob
}
// El dron es un activo del prestador, no un módulo eléctrico asociado a la instalación.
entity DroneAsset {
  assetCode String required maxlength(100)
  modelName String maxlength(120)
  status DroneAssetStatus required
  maximumWindMs BigDecimal
}
entity DroneMission {
  missionCode String required maxlength(100)
  kind DroneMissionKind required
  status DroneMissionStatus required
  proposedAt Instant required
  startedAt Instant
  completedAt Instant
  safetyChecklistSummary TextBlob
}
entity MissionAuthorization {
  status MissionAuthorizationStatus required
  decidedAt Instant
  expiresAt Instant
  operatorReference String maxlength(120)
  decisionNote TextBlob
}
entity VerificationResult {
  status VerificationStatus required
  assessedAt Instant required
  baselineMethod String required maxlength(120)
  recoveredWh BigDecimal
  evidenceSummary TextBlob
}

relationship ManyToOne {
  OrganizationMembership{organization(name) required} to Organization
  OrganizationMembership{member(login) required} to User with builtInEntity

  Site{organization(name) required} to Organization
  Installation{organization(name) required} to Organization
  Installation{site(name) required} to Site
  InstallationAccessGrant{organization(name) required} to Organization
  InstallationAccessGrant{installation(name) required} to Installation
  InstallationAccessGrant{granteeOrganization(name) required} to Organization

  SolarArray{organization(name) required} to Organization
  SolarArray{installation(name) required} to Installation
  SolarString{organization(name) required} to Organization
  SolarString{solarArray(name) required} to SolarArray
  SolarString{moduleModel(modelCode)} to EquipmentModel
  Equipment{organization(name) required} to Organization
  Equipment{installation(name) required} to Installation
  Equipment{equipmentModel(modelCode) required} to EquipmentModel
  Equipment{solarString(stringCode)} to SolarString
  Gateway{organization(name) required} to Organization
  Gateway{installation(name) required} to Installation
  TelemetryChannel{organization(name) required} to Organization
  TelemetryChannel{equipment(tag) required} to Equipment
  TelemetryChannel{metricDefinition(code) required} to MetricDefinition

  AlertRule{organization(name) required} to Organization
  AlertRule{installation(name)} to Installation
  Incident{organization(name) required} to Organization
  Incident{installation(name) required} to Installation
  Incident{alertRule(name)} to AlertRule
  IncidentEvent{organization(name) required} to Organization
  IncidentEvent{incident(title) required} to Incident
  EnergyModelRun{organization(name) required} to Organization
  EnergyModelRun{installation(name) required} to Installation
  LossAssessment{organization(name) required} to Organization
  LossAssessment{modelRun(modelName) required} to EnergyModelRun
  LossCauseEstimate{organization(name) required} to Organization
  LossCauseEstimate{lossAssessment(methodology) required} to LossAssessment

  TariffPlan{organization(name) required} to Organization
  TariffPlan{installation(name) required} to Installation
  TariffRate{organization(name) required} to Organization
  TariffRate{tariffPlan(name) required} to TariffPlan
  EconomicAssessment{organization(name) required} to Organization
  EconomicAssessment{lossAssessment(methodology) required} to LossAssessment
  EconomicAssessment{tariffRate(id)} to TariffRate

  AuditTemplate{organization(name) required} to Organization
  AuditQuestion{organization(name) required} to Organization
  AuditQuestion{auditTemplate(title) required} to AuditTemplate
  AuditReport{organization(name) required} to Organization
  AuditReport{installation(name) required} to Installation
  AuditReport{auditTemplate(title) required} to AuditTemplate
  AuditReport{auditorMembership(id)} to OrganizationMembership
  AuditAnswer{organization(name) required} to Organization
  AuditAnswer{auditReport(id) required} to AuditReport
  AuditAnswer{auditQuestion(questionCode) required} to AuditQuestion
  AuditFinding{organization(name) required} to Organization
  AuditFinding{auditReport(id) required} to AuditReport
  AuditEvidence{organization(name) required} to Organization
  AuditEvidence{finding(id) required} to AuditFinding

  MaintenancePlan{organization(name) required} to Organization
  MaintenancePlanVersion{organization(name) required} to Organization
  MaintenancePlanVersion{maintenancePlan(name) required} to MaintenancePlan
  ServiceAgreement{organization(name) required} to Organization
  ServiceAgreement{providerOrganization(name) required} to Organization
  ServiceAgreement{installation(name) required} to Installation
  PlanSubscription{organization(name) required} to Organization
  PlanSubscription{installation(name) required} to Installation
  PlanSubscription{planVersion(versionCode) required} to MaintenancePlanVersion
  PlanSubscription{serviceAgreement(id) required} to ServiceAgreement
  ServiceProposal{organization(name) required} to Organization
  ServiceProposal{installation(name) required} to Installation
  ServiceProposal{planVersion(versionCode)} to MaintenancePlanVersion
  WorkOrder{organization(name) required} to Organization
  WorkOrder{installation(name) required} to Installation
  WorkOrder{incident(title)} to Incident
  WorkOrder{subscription(id)} to PlanSubscription
  WorkOrder{assignedMembership(id)} to OrganizationMembership
  WorkOrderTask{organization(name) required} to Organization
  WorkOrderTask{workOrder(referenceCode) required} to WorkOrder
  MaintenanceIntervention{organization(name) required} to Organization
  MaintenanceIntervention{workOrder(referenceCode) required} to WorkOrder
  InterventionEvidence{organization(name) required} to Organization
  InterventionEvidence{intervention(id) required} to MaintenanceIntervention
  RecoveryAssessment{organization(name) required} to Organization
  RecoveryAssessment{intervention(id) required} to MaintenanceIntervention
  RecoveryAssessment{modelRun(modelName)} to EnergyModelRun

  DeviceIdentity{organization(name) required} to Organization
  DeviceIdentity{gateway(hardwareId)} to Gateway
  DeviceIdentity{equipment(tag)} to Equipment
  TelemetryIntegrityEvent{organization(name) required} to Organization
  TelemetryIntegrityEvent{installation(name) required} to Installation
  TelemetryIntegrityEvent{deviceIdentity(deviceUid)} to DeviceIdentity
  TelemetryIntegrityEvent{telemetryChannel(externalChannelCode)} to TelemetryChannel
  IntegrityAssessment{organization(name) required} to Organization
  IntegrityAssessment{installation(name) required} to Installation
  IntegrityAssessment{integrityEvent(eventUid) required} to TelemetryIntegrityEvent
  IntegrityAssessment{modelRun(modelName)} to EnergyModelRun
  DataProvenance{organization(name) required} to Organization
  DataProvenance{installation(name) required} to Installation
  DataProvenance{evidenceSource(code) required} to EvidenceSource
  DataProvenance{modelRun(modelName)} to EnergyModelRun
  SecurityIncident{organization(name) required} to Organization
  SecurityIncident{installation(name) required} to Installation
  SecurityIncident{integrityAssessment(id)} to IntegrityAssessment
  DroneAsset{organization(name) required} to Organization
  DroneMission{organization(name) required} to Organization
  DroneMission{installation(name) required} to Installation
  DroneMission{workOrder(referenceCode)} to WorkOrder
  DroneMission{droneAsset(assetCode)} to DroneAsset
  DroneMission{providerOrganization(name)} to Organization
  MissionAuthorization{organization(name) required} to Organization
  MissionAuthorization{mission(missionCode) required} to DroneMission
  MissionAuthorization{authorizedByMembership(id)} to OrganizationMembership
  VerificationResult{organization(name) required} to Organization
  VerificationResult{installation(name) required} to Installation
  VerificationResult{droneMission(missionCode)} to DroneMission
  VerificationResult{recoveryAssessment(id)} to RecoveryAssessment
}

dto * with mapstruct
service * with serviceClass
paginate Installation, Equipment, Gateway, Incident, AuditReport, WorkOrder, PlanSubscription, ServiceProposal, TelemetryIntegrityEvent, SecurityIncident, DroneMission with pagination
